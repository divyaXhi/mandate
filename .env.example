# Required only for the online payment path. Use Razorpay Test Mode keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Optional: natural-language intent parsing. Without a key, deterministic local
# parsing continues to work.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: live catalog lookup. Without a key, the local catalog is used.
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
